msgid "Staff — dashboard access"
msgstr "Προσωπικό — πρόσβαση στον πίνακα ελέγχου"

msgid "Superuser — full control"
msgstr "Υπερδιαχειριστής — πλήρης έλεγχος"

msgid "Common"
msgstr "Κοινή"

msgid "Uncommon"
msgstr "Ασυνήθιστη"

msgid "Rare"
msgstr "Σπάνια"

msgid "Super Rare"
msgstr "Πολύ σπάνια"

msgid "Secret Rare"
msgstr "Μυστική σπάνια"

msgid "Legendary"
msgstr "Θρυλική"

msgid "Pending"
msgstr "Σε αναμονή"

msgid "Paid"
msgstr "Πληρώθηκε"

msgid "Cancelled"
msgstr "Ακυρώθηκε"

msgid "Newest first"
msgstr "Νεότερες πρώτα"

msgid "Price: low to high"
msgstr "Τιμή: χαμηλή προς υψηλή"

msgid "Price: high to low"
msgstr "Τιμή: υψηλή προς χαμηλή"

msgid "Best rated"
msgstr "Καλύτερη βαθμολογία"

msgid "Name A–Z"
msgstr "Όνομα Α–Ω"

msgid "Cards"
msgstr "Κάρτες"

msgid "Pick a star rating between 1 and 5."
msgstr "Διάλεξε βαθμολογία από 1 έως 5 αστέρια."

msgid "Review posted. Thanks, nakama!"
msgstr "Η αξιολόγηση δημοσιεύτηκε. Ευχαριστούμε, nakama!"

msgid "Your review has been updated."
msgstr "Η αξιολόγησή σου ενημερώθηκε."

msgid "Your review has been removed."
msgstr "Η αξιολόγησή σου αφαιρέθηκε."

#, python-format
msgid "\"%(name)s\" is sold out."
msgstr "Η κάρτα «%(name)s» έχει εξαντληθεί."

#, python-format
msgid "\"%(name)s\" added to your cart."
msgstr "Η κάρτα «%(name)s» προστέθηκε στο καλάθι σου."

msgid "Your cart is empty."
msgstr "Το καλάθι σου είναι άδειο."

#, python-format
msgid "Not enough stock left for: %(cards)s. Please update your cart."
msgstr "Δεν υπάρχει αρκετό απόθεμα για: %(cards)s. Ενημέρωσε το καλάθι σου."

#, python-format
msgid "Welcome aboard, %(name)s!"
msgstr "Καλώς ήρθες στο πλοίο, %(name)s!"

msgid "Your profile has been updated."
msgstr "Το προφίλ σου ενημερώθηκε."

#, python-format
msgid "Order #%(id)s marked as %(status)s."
msgstr "Η παραγγελία #%(id)s σημειώθηκε ως: %(status)s."

#, python-format
msgid "\"%(name)s\" updated."
msgstr "Η κάρτα «%(name)s» ενημερώθηκε."

#, python-format
msgid "\"%(name)s\" added to the vault."
msgstr "Η κάρτα «%(name)s» προστέθηκε στο θησαυροφυλάκιο."

#, python-format
msgid "\"%(name)s\" removed from the vault."
msgstr "Η κάρτα «%(name)s» αφαιρέθηκε από το θησαυροφυλάκιο."

msgid "You can't modify or delete your own account from here — use your profile."
msgstr "Δεν μπορείς να τροποποιήσεις ή να διαγράψεις τον δικό σου λογαριασμό από εδώ — χρησιμοποίησε το προφίλ σου."

msgid "Only a superuser can manage another superuser."
msgstr "Μόνο ένας υπερδιαχειριστής μπορεί να διαχειριστεί άλλον υπερδιαχειριστή."

msgid "Only a superuser can create superusers."
msgstr "Μόνο ένας υπερδιαχειριστής μπορεί να δημιουργήσει υπερδιαχειριστές."

#, python-format
msgid "Account \"%(name)s\" created."
msgstr "Ο λογαριασμός «%(name)s» δημιουργήθηκε."

msgid "Only a superuser can grant superuser privileges."
msgstr "Μόνο ένας υπερδιαχειριστής μπορεί να δώσει δικαιώματα υπερδιαχειριστή."

#, python-format
msgid "Account \"%(name)s\" updated."
msgstr "Ο λογαριασμός «%(name)s» ενημερώθηκε."

#, python-format
msgid "\"%(name)s\" has no email address on file — add one first."
msgstr "Ο χρήστης «%(name)s» δεν έχει καταχωρημένο email — πρόσθεσε πρώτα ένα."

#, python-format
msgid "Password reset link sent to %(email)s."
msgstr "Ο σύνδεσμος επαναφοράς κωδικού στάλθηκε στο %(email)s."

msgid "Could not send the reset email."
msgstr "Δεν ήταν δυνατή η αποστολή του email επαναφοράς."

#, python-format
msgid "Account \"%(name)s\" deleted. Their orders are kept for the records."
msgstr "Ο λογαριασμός «%(name)s» διαγράφηκε. Οι παραγγελίες του διατηρούνται στο αρχείο."

#, python-format
msgid "%(counter)s review"
msgid_plural "%(counter)s reviews"
msgstr[0] "%(counter)s αξιολόγηση"
msgstr[1] "%(counter)s αξιολογήσεις"

#, python-format
msgid "%(counter)s card found"
msgid_plural "%(counter)s cards found"
msgstr[0] "Βρέθηκε %(counter)s κάρτα"
msgstr[1] "Βρέθηκαν %(counter)s κάρτες"

#, python-format
msgid "%(counter)s item"
msgid_plural "%(counter)s items"
msgstr[0] "%(counter)s είδος"
msgstr[1] "%(counter)s είδη"
